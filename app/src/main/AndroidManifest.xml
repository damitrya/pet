<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Overlay permission -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Location for GPS speed & weather -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Auto-start on boot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Notification posting (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Media state: active sessions come through the notification listener below (user-granted
         notification access), with AudioManager as the fallback. No privileged permission needed. -->

    <!-- Step counter / activity recognition (Android 10+, optional) -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Weather API (optional) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- App usage monitoring (optional, special permission) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Phone call detection (optional) -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Haptic responses to the user's touches (VibrationEffect patterns); a normal permission, no prompt -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Bluetooth auto-profile switching (optional) -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mimio">

        <!-- Main Settings Activity -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Motion diagnostics (AUTO settings) -->
        <activity
            android:name=".ui.DrivingDiagnosticsActivity"
            android:exported="false"
            android:label="@string/section_driving_diagnostics" />

        <!-- Shares exported diagnostics reports (cache/diagnostics_export only) with the Sharesheet -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.diagnostics"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/diagnostics_file_paths" />
        </provider>

        <!-- Companion Foreground Service -->
        <service
            android:name=".service.CompanionService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Boot Receiver for auto-start -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Quick Settings Tile -->
        <service
            android:name=".receiver.CompanionTileService"
            android:exported="true"
            android:icon="@drawable/ic_companion_notification"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- Notification Listener (for MediaSession access) -->
        <service
            android:name=".data.MediaStateProvider$NotificationListenerStub"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
